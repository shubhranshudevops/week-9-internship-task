pipeline {

    agent any
    
    tools {
            nodejs 'node'
    }
    
    environment {
        INSTANCE_IP = "52.66.237.80"  // This is EC2 Instance Public IP so Change it if you restart instance
        APP_NAME = "week-9-activity-internship"
        DOCKER_IMAGE = "shubh01devops/week-9-internship-activity"
        IMAGE_TAG = "${BUILD_NUMBER}"
        CURRENT_IMAGE = "${DOCKER_IMAGE}:${IMAGE_TAG}"
        CONTAINER_NAME = "week-9-activity-container"
        APPLICATION_PORT = "3000"
        // File used to store the last successfully deployed image 
        STABLE_IMAGE_FILE = ".last_successful_image"   
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code from GitHub...'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Installing dependencies and building application...'  // Use Single Quotes(') for plain text without any variables. Jenkins will print the text exactly as written.
                sh 'npm install'                                            // Use Single Quotes(') for plain text without any variables. Jenkins will print the text exactly as written
                sh 'npm run build'
            }
        }

        stage('Test') {
            steps {
                echo 'Running automated tests...'
                sh 'npm test'
            }
        }

        stage('Docker Build') {
            steps {
                echo "Building Docker image :${CURRENT_IMAGE}..."  // se Double Quotes (") when you want to include and evaluate variables inside the string.
                sh "docker build -t ${CURRENT_IMAGE} ."           //Use Double Quotes (") when you want to include and evaluate variables inside the string.
            }
        }

        stage('Docker Push') {
            steps {
                echo 'Pushing Docker image to Docker Hub...'
                withCredentials([usernamePassword(credentialsId: 'docker_hub', usernameVariable: 'DOCKER_USERNAME', passwordVariable: 'DOCKER_PASSWORD')]) 
                {
                    sh "echo ${DOCKER_PASSWORD} | docker login -u ${DOCKER_USERNAME} --password-stdin"
                    sh "docker push ${CURRENT_IMAGE}"
                    sh 'docker logout'
                }
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying new application version...'
                sh "docker rm -f ${CONTAINER_NAME} || true"
                sh "docker run -d --name ${CONTAINER_NAME} -p ${APPLICATION_PORT}:3000 ${CURRENT_IMAGE}"
                echo 'New application version deployed Successfully...'
            }
        }

        stage('Verify') {
            steps { 
                script {
                    echo 'Waiting for application to start...'
                    sleep 10
                    echo 'Checking application health...'
                    def healthResponse = sh(
                        script: """
                        curl --show-error http://${INSTANCE_IP}:${APPLICATION_PORT}/health
                        """,
                        returnStatus: true
                    ).trim()
                    echo "Health Response: ${healthResponse}"
                    if (healthResponse.contains('"status":"UP"')) {
                        echo 'Application verification successful...'
                        echo 'Application is Healthy & Rollback is NOT Required...'
                        env.DEPLOYMENT_FAILED = "false"
                    } 
                    else { 
                        echo 'Application verification FAILED...'
                        echo 'Starting Rollback...'
                        env.DEPLOYMENT_FAILED = "true" 
                    }
                }
            }
        }

        stage('Rollback') { 
            when { 
                expression { return env.DEPLOYMENT_FAILED == "true" } 
            } 
            steps { 
                script {  
                    echo 'Deployment failed. Starting rollback...'
                    def stableImageExists = fileExists( "${STABLE_IMAGE_FILE}" ) 
                    if (stableImageExists) { 
                        def stableImage = readFile( "${STABLE_IMAGE_FILE}" ).trim() 
                        echo "Last successful deployment: ${stableImage}"
                        echo 'Pulling the last stable Docker image...'
                        sh "docker pull ${stableImage}" 
                        echo 'Removing failed deployment...' 
                        sh "docker rm -f ${CONTAINER_NAME} || true" 
                        echo 'Starting previous stable version...' 
                        sh "docker run -d --name ${CONTAINER_NAME} -p ${APPLICATION_PORT}:3000 ${stableImage}"
                        echo 'Verifying rollback...'
                        echo 'Waiting for application to start...'
                        sleep 10
                        echo 'Checking application health...'
                        sh "curl --show-error http://${INSTANCE_IP}:${APPLICATION_PORT}/health"
                        echo 'Rollback completed successfully...' 
                        echo "Application restored to ${stableImage}"
                    }
                    else {
                        echo 'No previous successful deployment found...'
                        echo 'Rollback cannot be performed for the first deployment...'
                    }
                }
            }
        }

    //This stage runs ONLY when deployment and verification are successful.  
        stage('Save Stable Version') {
            when { 
                expression { return env.DEPLOYMENT_FAILED == "false" } 
            } 
            steps { 
                script {
                    echo "Saving ${CURRENT_IMAGE} as the last successful deployment..." 
                    writeFile( 
                            file: "${STABLE_IMAGE_FILE}",
                            text: "${CURRENT_IMAGE}" 
                    ) 
                    echo "Stable version saved: ${CURRENT_IMAGE}" 
                } 
            }
        }
    }

    post {
        success {
            echo '===================================================================='
            echo 'CI/CD Pipeline completed successfully...'
            echo 'Application deployed successfully...'
            echo '===================================================================='
        }

        failure {
            echo '===================================================================='
            echo 'Pipeline failed. Check the Jenkins console output.'
            echo '===================================================================='
        }

        always {
            echo '===================================================================='
            echo 'Pipeline execution completed....'
            echo '===================================================================='
        }
    }
}
